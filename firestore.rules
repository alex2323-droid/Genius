rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII isolation
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // Study Plans
    match /studyPlans/{planId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(planId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(attemptId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Community Feedback & Suggestions
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isValidId(feedbackId)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000;
      allow update: if true; // allow upvoting likes or admin status update
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'alexparababi23@gmail.com');
    }

    // Settings (such as custom logo)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'alexparababi23@gmail.com';
    }
  }
}
